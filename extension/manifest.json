{
  "manifest_version": 3,
  "name": "HumanProof 기여 기록",
  "version": "0.1.0",
  "description": "사용자가 확인한 AI/Human 기여 근거를 로컬에 저장하고 HumanProof로 내보냅니다.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_title": "HumanProof 기여 기록", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
